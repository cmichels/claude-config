  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f /tmp/claude-audit-enabled ] && exit 0; input=$(cat); tool=$(echo \"$input\" | jq -r '.tool_name'); detail=$(echo \"$input\" | jq -r '.tool_input | (.command // .file_path // .skill // .query // .issueIdOrKey // \"—\")' 2>/dev/null); echo \"${tool}\t${detail}\" >> /tmp/claude-permission-audit.log; exit 0",
            "statusMessage": "Auditing tool use"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | jq -r '.tool_input.skill // .tool_input // \"\"' | grep -qi 'insights'; then report=\"$HOME/.claude/usage-data/report.html\"; if [ -f \"$report\" ]; then d=$(stat -c '%y' \"$report\" | cut -d' ' -f1); dest=\"$HOME/.claude/usage-data/report-${d}.html\"; [ ! -f \"$dest\" ] && command cp \"$report\" \"$dest\"; fi; fi; exit 0",
            "statusMessage": "Archiving previous insights report"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE 'git (commit|push)'; then branch=$(git branch --show-current 2>/dev/null); if [ -n \"$branch\" ]; then case \"$branch\" in feature/*|bug/*|bugfix/*|dev|main|master) exit 0 ;; *) echo \"Branch '$branch' does not follow naming convention (feature/*, bug/*, bugfix/*). Create a properly named branch first.\" >&2; exit 2 ;; esac; fi; fi; exit 0",
            "statusMessage": "Validating branch naming convention"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); cmd=$(echo \"$input\" | jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -qE 'git commit'; then sig=$(git log -1 --show-signature 2>&1); if echo \"$sig\" | grep -q 'Good signature'; then echo 'GPG signature verified.'; else echo 'WARNING: Last commit may not be GPG-signed. Run ~/bin/claude-preflight.sh to diagnose.' >&2; fi; fi; exit 0",
            "statusMessage": "Verifying GPG commit signature"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); filepath=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$filepath\" in *.go) gofmt -w \"$filepath\" 2>/dev/null; dir=$(dirname \"$filepath\"); go vet \"$dir/...\" 2>&1 | head -20 || true ;; esac; exit 0",
            "statusMessage": "Formatting and vetting Go file"
          },
          {
            "type": "command",
            "command": "input=$(cat); filepath=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$filepath\" in go.mod) dir=$(dirname \"$filepath\"); cd \"$dir\" && go mod tidy 2>/dev/null || true ;; esac; exit 0",
            "statusMessage": "Tidying go.mod"
          },
          {
            "type": "command",
            "command": "input=$(cat); filepath=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$filepath\" in *.ts|*.js|*.html|*.css|*.scss) dir=\"$filepath\"; while [ \"$dir\" != \"/\" ]; do dir=$(dirname \"$dir\"); if [ -f \"$dir/.eslintrc.json\" ] || [ -f \"$dir/.eslintrc.js\" ] || [ -f \"$dir/.eslintrc.yml\" ] || [ -f \"$dir/eslint.config.js\" ] || [ -f \"$dir/eslint.config.mjs\" ]; then cd \"$dir\" && npx eslint --fix \"$filepath\" 2>&1 | head -20 || true; break; fi; done ;; esac; exit 0",
            "statusMessage": "Linting web file"
          },
          {
            "type": "command",
            "command": "input=$(cat); filepath=$(echo \"$input\" | jq -r '.tool_input.file_path // \"\"'); case \"$filepath\" in *.ts|*.tsx) dir=\"$filepath\"; while [ \"$dir\" != \"/\" ]; do dir=$(dirname \"$dir\"); if [ -f \"$dir/tsconfig.json\" ]; then cd \"$dir\" && npx tsc --noEmit 2>&1 | head -30 || true; break; fi; done ;; esac; exit 0",
            "statusMessage": "Type-checking TypeScript"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "zsh $HOME/.claude/status-line.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "teammateMode": "auto"
}
